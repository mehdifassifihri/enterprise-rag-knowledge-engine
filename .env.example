# Copy to .env; replace BOTH placeholders before starting. Never commit .env.
POSTGRES_USER=eke
POSTGRES_DB=eke
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD
# URL-encode special characters in the password; token_hex avoids this issue.
DATABASE_URL=postgresql+psycopg://eke:REPLACE_WITH_GENERATED_PASSWORD@localhost:5432/eke
API_KEY=REPLACE_WITH_GENERATED_API_KEY
DOCS_ENABLED=true
LOG_LEVEL=INFO

# Required for document access. Provision this UUID using the administrative command in README.
API_KEY_TENANT_ID=11111111-1111-1111-1111-111111111111
# Optional additional bindings, JSON object of tenant UUID to generated API key.
# TENANT_API_KEYS={"22222222-2222-2222-2222-222222222222":"REPLACE_WITH_ANOTHER_GENERATED_KEY"}
TENANT_API_KEYS={}

# Set fake explicitly for a free deterministic local demonstration. Never use fake for retrieval.
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Must match the migration's VECTOR(1536); changing dimension requires a schema migration.
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=20
MAX_UPLOAD_BYTES=10485760
MAX_EXTRACTED_CHARS=1000000
MAX_PDF_PAGES=200
PDF_TIMEOUT_SECONDS=15
CHUNK_SIZE=1500
CHUNK_OVERLAP=200
MAX_CHUNKS=1000

# Retrieval: each source returns at most this many candidates; API top_k is 1..50.
SEARCH_CANDIDATE_LIMIT=50
SEARCH_RRF_K=60
# Exact is deterministic and recall-safe for small/medium tenants. HNSW is optional approximate search.
SEARCH_VECTOR_STRATEGY=exact
SEARCH_HNSW_EF_SEARCH=100
# Optional managed reranking, used only when request rerank=true. No-op is the default.
RERANKER_PROVIDER=none
RERANKER_MODEL=rerank-v5.0-pro
RERANKER_MAX_CANDIDATES=50
RERANKER_TIMEOUT_SECONDS=10
COHERE_API_KEY=

# Grounded question answering. OpenAI chat shares the existing OPENAI_API_KEY.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_MAX_OUTPUT_TOKENS=1200
QA_DEFAULT_TOP_K=5
QA_SEARCH_MODE=hybrid
QA_RERANK=false
QA_MAX_SOURCES=8
# Counts serialized source JSON, including metadata; not a token count.
QA_CONTEXT_CHAR_BUDGET=12000
QA_MAX_PASSAGE_CHARS=2000
# Uncalibrated evidence gates; never threshold RRF as probability.
QA_MIN_COSINE_SIMILARITY=0.2
QA_MIN_KEYWORD_SCORE=0.0
# LLM_PROVIDER=fake always abstains unless explicitly scripted by tests/demo code.

# Local stdio MCP: copy an existing tenant-bound API_KEY or TENANT_API_KEYS value.
# Set this only in your ignored .env; never put a real credential in client JSON.
MCP_API_KEY=
MCP_MAX_OUTPUT_BYTES=262144
MCP_MAX_CONCURRENT_CALLS=1

# SHA-256 hashes of revoked API keys, JSON array; update configuration and restart all processes.
REVOKED_API_KEY_HASHES=[]
# SDK retries only; external calls can still incur duplicate billing on ambiguous failures.
EMBEDDING_MAX_RETRIES=1
# Optional judge is CLI-only: --allow-paid --answers --judge-provider openai --judge-model MODEL.
# It uses OPENAI_API_KEY; no judge or paid evaluation runs by default.
